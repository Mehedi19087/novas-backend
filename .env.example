# Cloudinary Configuration
# Obtain these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Local/Production Database URL (automatically set on Railway)
# DATABASE_URL=postgresql://user:password@localhost:5432/novas_db
